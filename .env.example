# Copy this file to .env and fill in your values. Do not commit .env.
# All keys below are optional; the app falls back to Nominatim (OSM) for location autocomplete if unset.

PLACES_API_KEY=
PLACES_API_KEY_ANDROID=

# LinkedIn OAuth (required for LinkedIn login). Get from https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# PostHog (optional — analytics disabled if API key empty)
POSTHOG_API_CLIENT_KEY=
POSTHOG_HOST=
